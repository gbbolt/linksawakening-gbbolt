        1,
        63
      ],
      "max_seconds": 12
    }
  },
  "music_channels": {
    "_doc": "per channel: its RAM record, the offset of the pattern pointer (the note just played is the byte before it), the pattern list pointer, and the flag byte/bit set while a sound effect owns the channel",
    "structs": [
      "wMusicChannel1",
      "wMusicChannel2",
      "wMusicChannel3",
      "wMusicChannel4"
    ],
    "pattern_ptr": 4,
    "list_ptr": 0,
    "effect_flag": [
      15,
      128
    ]
  },
  "effect_channels": {
    "jingle": [
      0,
      1
    ],
    "wave": [
      2
    ],
    "noise": [
      3
    ]
  },
